___SANDBOXED_JS_FOR_SERVER___

/**
 * BigQuery Event Tag - Optimized Version with Async Pattern
 * 
 * Key optimizations:
 * 1. claimRequest() - Returns HTTP 200 immediately, BigQuery insert runs in background
 * 2. Single getAllEventData() call - cached and reused
 * 3. Single getEventData() calls for common fields - cached at top
 * 4. Object-based lookups instead of array.indexOf()
 * 5. Reduced object traversals
 * 6. Early returns where possible
 * 
 * IMPORTANT: With claimRequest(), the response is sent to the client BEFORE
 * BigQuery insert completes. If BigQuery fails, the client won't know.
 * This is acceptable for analytics data where occasional loss is tolerable.
 */

const log = require('logToConsole');
const BigQuery = require('BigQuery');
const makeInteger = require('makeInteger');
const makeString = require('makeString');
const JSON = require('JSON');
const getTimestampMillis = require('getTimestampMillis');
const getType = require('getType');
const Object = require('Object');
const parseUrl = require('parseUrl');
const getEventData = require('getEventData');
const getAllEventData = require('getAllEventData');
const computeEffectiveTldPlusOne = require('computeEffectiveTldPlusOne');
const Math = require('Math');

// Note: claimRequest is for CLIENT templates, not needed for TAG templates
// For tags, we use the early gtmOnSuccess() pattern instead

// ============================================================================
// OPTIMIZATION 1: Cache all event data ONCE at the very beginning
// ============================================================================
const cachedAllEventData = getAllEventData();

// Read a field from the already-fetched event-data snapshot when present,
// falling back to getEventData for keys it doesn't expose (e.g. x-ga-* headers).
// Eliminates duplicate sandbox calls per event; returned value is identical.
const ed = (key) => {
  if (getType(cachedAllEventData) === 'object') {
    const v = cachedAllEventData[key];
    if (v !== undefined) return v;
  }
  return getEventData(key);
};

// ============================================================================
// OPTIMIZATION 2: Cache common event data fields ONCE
// These are accessed multiple times across different functions
// ============================================================================
const cache = {
  // Core identifiers
  eventOrigin: ed('event_origin'),
  clientId: ed('client_id'),
  userId: ed('user_id'),

  // Platform detection fields
  appId: ed('app_id'),
  firebaseId: ed('firebase_id'),
  appInstanceId: ed('x-ga-app_instance_id'),
  xGaPlatform: ed('x-ga-platform'),
  pageLocation: ed('page_location'),

  // Device/User agent
  clientHints: ed('client_hints'),
  userAgent: ed('user_agent'),
  deviceModel: ed('x-ga-device_model'),
  osVersion: ed('x-ga-os_version'),

  // Session
  gaSessionId: ed('ga_session_id'),
  gaSessionNumber: ed('ga_session_number'),

  // User properties (Firebase)
  mp2UserProperties: ed('x-ga-mp2-user_properties'),

  // Other common fields
  screenResolution: ed('screen_resolution'),
  language: ed('language'),
  pageHostname: ed('page_hostname'),
  host: ed('host'),
  pageReferrer: ed('page_referrer'),
  eventLocation: ed('event_location'),

  // Privacy
  xGaGcs: ed('x-ga-gcs'),
  gcs: ed('gcs'),

  // Timestamps
  eventDate: ed('event_date'),
  eventTimestamp: ed('event_timestamp'),

  // Stream ID candidates
  streamId: ed('stream_id') ||
            ed('ga_stream_id') ||
            ed('data_stream_id') ||
            ed('streamId') ||
            ed('x-ga-stream_id') ||
            ed('x-ga-gcs-stream-id')
};

// Parse the page location once and reuse (traffic attribution + collected traffic source)
const parsedPageUrl = cache.pageLocation ? parseUrl(cache.pageLocation) : null;

// ============================================================================
// OPTIMIZATION 3: Use object-based lookups instead of array.indexOf()
// Object property access is O(1) vs O(n) for array.indexOf()
// ============================================================================
const SYSTEM_FIELDS = {
  // Core identifiers
  'client_id': 1, 'user_id': 1, 'ga_session_id': 1, 'ga_session_number': 1,
  'app_id': 1, 'firebase_id': 1, 'x-ga-app_instance_id': 1, 'app_instance_id': 1,
  
  // Page and referrer info
  'page_location': 1, 'page_referrer': 1, 'page_hostname': 1, 'host': 1,
  
  // User agent and device info
  'user_agent': 1, 'client_hints': 1, 'language': 1, 'screen_resolution': 1,
  'time_zone_offset_seconds': 1, 'advertising_id': 1, 'vendor_id': 1,
  'is_limited_ad_tracking': 1, 'x-ga-device_model': 1, 'x-ga-os_version': 1,
  'x-ga-platform': 1, 'x-ga-app_store': 1, 'x-ga-vendor_device_id': 1,
  'x-ga-time_zone_offset_minutes': 1,
  
  // Geographic info
  'event_location': 1, 'geo_continent': 1, 'geo_sub_continent': 1,
  'geo_subcontinent': 1, 'geo_country': 1, 'geo_region': 1, 'geo_metro': 1, 'geo_city': 1,
  
  // Privacy and consent
  'x-ga-gcs': 1, 'gcs': 1, 'x-sst-system_properties': 1,
  
  // Date and time
  'event_date': 1, 'event_timestamp': 1, 'x-ga-timestamp_millis': 1,
  'x-ga-previous_timestamp_millis': 1,
  
  // Event name and origin
  'event_name': 1, 'event_origin': 1,
  
  // App-specific system fields
  'x-ga-mp2-user_properties': 1, 'x-ga-system_properties': 1,
  'x-ga-audience_evaluation_results': 1, 'x-ga-bundle_sequential_index': 1,
  'x-ga-consent_diagnostics': 1, 'x-ga-dma': 1, 'x-ga-dma_cps': 1,
  'x-ga-limited_ad_tracking': 1, 'x-ga-attmas': 1, 'x-ga-protocol_version': 1,
  'x-ga-redacted_fields': 1, 'x-ga-gmp_app_id': 1, 'x-ga-app_version_major': 1,
  
  // Internal sGTM fields
  '_gtm_server_preview': 1, '_gtm_server_debug': 1, '_gtm_server_sid': 1,
  '_gtm_server_tid': 1, '_gtm_server_version': 1,
  
  // Request-specific fields
  'request_id': 1, 'request_start_time_ms': 1
};

// User property system fields (for exclusion)
const USER_SYSTEM_FIELDS = {
  'user_id': 1, 'user_agent': 1, 'user_pseudo_id': 1, 'x-ga-npa': 1
};

// ============================================================================
// HELPER FUNCTIONS (simplified)
// ============================================================================

const padZero = (num) => num < 10 ? '0' + num : '' + num;

const parseDate = (timestampMillis) => {
  const timestampDays = Math.floor(timestampMillis / 60 / 60 / 24 / 1000);
  const days = timestampDays + 719468;
  const era = Math.floor((days >= 0 ? days : days - 146097) / 146097);
  const doe = days - era * 146097;
  const yoe = Math.floor((doe + (-Math.floor(doe / 1460)) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365);
  const y = yoe + era * 400;
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
  const mp = Math.floor((5 * doy + 2) / 153);
  const d = 1 + doy - Math.floor(((153 * mp) + 2) / 5);
  const m = mp < 10 ? mp + 3 : mp - 9;
  return { year: y + (m <= 2), month: padZero(m), day: padZero(d) };
};

// Simplified string contains check
const stringContains = (str, substr) => {
  return str && substr && str.indexOf(substr) !== -1;
};

// Falls back to the date of the row's own event_timestamp (not a fresh server
// read) so event_date and event_timestamp can't disagree around midnight.
const formatDateForBigQuery = (fallbackMillis) => {
  const eventDate = cache.eventDate;
  if (eventDate && getType(eventDate) === 'string') {
    if (eventDate.length === 10 && eventDate.indexOf('-') === 4) {
      return eventDate;
    }
    if (eventDate.length === 8) {
      return eventDate.substring(0, 4) + '-' + eventDate.substring(4, 6) + '-' + eventDate.substring(6, 8);
    }
  }
  const parsedDate = parseDate(fallbackMillis);
  return parsedDate.year + '-' + parsedDate.month + '-' + parsedDate.day;
};

const convertToString = (fieldValue) => {
  if (getType(fieldValue) === 'null' || getType(fieldValue) === 'undefined') {
    return;
  }
  return makeString(fieldValue);
};

const identifyDataType = (fieldValue) => {
  if (fieldValue === null || fieldValue === undefined) return;
  const fieldType = typeof fieldValue;
  if (fieldType === 'string') return 'string_value';
  if (fieldType === 'number') return makeInteger(fieldValue) === fieldValue ? 'int_value' : 'float_value';
  if (fieldType === 'object') return 'string_value';
  if (fieldType === 'boolean') return 'int_value';
};

const changeDataType = (fieldValue) => {
  if (typeof fieldValue === 'object' && fieldValue !== null) {
    return JSON.stringify(fieldValue);
  } else if (typeof fieldValue === 'boolean') {
    return fieldValue ? 1 : 0;
  }
  return fieldValue;
};

// ============================================================================
// PLATFORM DETECTION (uses cached values)
// ============================================================================
const determinePlatform = () => {
  const eventOrigin = cache.eventOrigin;
  const xGaPlatform = cache.xGaPlatform;
  const appId = cache.appId;
  
  // Quick check for explicit platform
  if (xGaPlatform) {
    if (xGaPlatform === 'ios' || xGaPlatform === 'iOS') return 'iOS';
    if (xGaPlatform === 'android' || xGaPlatform === 'Android') return 'Android';
  }
  
  // Check event_origin for app events
  if (eventOrigin === 'app' || eventOrigin === 'am') {
    // Check app_id for platform hints
    if (appId) {
      if (stringContains(appId, 'ios') || stringContains(appId, 'iOS')) return 'iOS';
      if (stringContains(appId, 'android') || stringContains(appId, 'Android')) return 'Android';
      
      // Check device model for iOS devices
      const deviceModel = cache.deviceModel;
      if (deviceModel && (stringContains(deviceModel, 'iPhone') || stringContains(deviceModel, 'iPad'))) {
        return 'iOS';
      }
    }
    
    // Check OS version format
    const osVersion = cache.osVersion;
    if (osVersion && stringContains(osVersion, '.') && !stringContains(osVersion, 'Android')) {
      return 'iOS';
    }
    
    return 'iOS'; // Default for app events
  }
  
  // Check for Firebase indicators
  if (cache.firebaseId || cache.appInstanceId) {
    if (appId && stringContains(appId, 'ios')) return 'iOS';
    if (appId && stringContains(appId, 'android')) return 'Android';
    return 'iOS';
  }
  
  // Web detection
  if (cache.pageLocation) return 'Web';
  
  return 'Web';
};

// ============================================================================
// DEVICE CATEGORY (uses cached values)
// ============================================================================
const determineDeviceCategory = () => {
  const eventOrigin = cache.eventOrigin;
  
  if (eventOrigin === 'app' || eventOrigin === 'am') {
    const deviceModel = cache.deviceModel;
    if (deviceModel) {
      if (stringContains(deviceModel, 'iPad')) return 'tablet';
      if (stringContains(deviceModel, 'iPhone') || stringContains(deviceModel, 'iPod')) return 'mobile';
      if (stringContains(deviceModel, 'Tablet')) return 'tablet';
    }
    return 'mobile';
  }
  
  const clientHints = cache.clientHints;
  if (clientHints && getType(clientHints) === 'object') {
    if (clientHints.mobile === true) return 'mobile';
    if (clientHints.model && (stringContains(clientHints.model, 'iPad') || stringContains(clientHints.model, 'Tablet'))) {
      return 'tablet';
    }
  }
  
  const userAgent = cache.userAgent;
  if (userAgent) {
    if (stringContains(userAgent, 'iPad') || 
        (stringContains(userAgent, 'Android') && !stringContains(userAgent, 'Mobile')) ||
        stringContains(userAgent, 'Tablet')) {
      return 'tablet';
    }
    if (stringContains(userAgent, 'iPhone') ||
        (stringContains(userAgent, 'Android') && stringContains(userAgent, 'Mobile')) ||
        stringContains(userAgent, 'Mobile')) {
      return 'mobile';
    }
  }
  
  return 'desktop';
};

// ============================================================================
// USER PSEUDO ID (uses cached values)
// ============================================================================
const getUserPseudoId = (platform) => {
  if (platform === 'iOS' || platform === 'Android') {
    const appInstanceId = cache.appInstanceId || getEventData('app_instance_id') || getEventData('firebase_instance_id');
    if (appInstanceId) return convertToString(appInstanceId);
    if (cache.firebaseId) return convertToString(cache.firebaseId);
  }
  return convertToString(cache.clientId || '(not set)');
};

// ============================================================================
// USER ID EXTRACTION (uses cached values)
// ============================================================================
const extractUserId = () => {
  if (data.user_id) return convertToString(data.user_id);
  
  // Check mp2 user properties
  const mp2UserProperties = cache.mp2UserProperties;
  if (mp2UserProperties && getType(mp2UserProperties) === 'object' && mp2UserProperties.user_id) {
    return convertToString(mp2UserProperties.user_id);
  }
  
  // Check direct user_id
  if (cache.userId) return convertToString(cache.userId);
  
  return null;
};

// ============================================================================
// SESSION INFO EXTRACTION (uses cached values)
// ============================================================================
const extractSessionInfo = () => {
  let sessionId = cache.gaSessionId;
  let sessionNumber = cache.gaSessionNumber ? makeInteger(cache.gaSessionNumber) : null;
  
  // Check mp2 user properties for Firebase events
  const mp2UserProperties = cache.mp2UserProperties;
  if (mp2UserProperties && getType(mp2UserProperties) === 'object') {
    if (!sessionId && mp2UserProperties.session_id) {
      sessionId = convertToString(mp2UserProperties.session_id);
    }
    if (!sessionNumber && mp2UserProperties.session_number) {
      sessionNumber = makeInteger(mp2UserProperties.session_number);
    }
  }
  
  // Default session number for app events
  const eventOrigin = cache.eventOrigin;
  if ((eventOrigin === 'app' || eventOrigin === 'am') && (!sessionNumber || sessionNumber === 0)) {
    sessionNumber = 1;
  }
  
  return {
    sessionId: sessionId ? convertToString(sessionId) : null,
    sessionNumber: sessionNumber || 0
  };
};

// ============================================================================
// TRAFFIC ATTRIBUTION (uses cached values)
// ============================================================================
const determineTrafficAttributes = () => {
  const eventOrigin = cache.eventOrigin;
  
  // App events get direct attribution
  if (eventOrigin === 'app' || eventOrigin === 'am') {
    return { source: '(direct)', medium: '(none)', campaign: '(not set)' };
  }
  
  const parsedUrl = parsedPageUrl;
  if (!parsedUrl) {
    return { source: '(not set)', medium: '(not set)', campaign: '(not set)' };
  }
  
  const searchParams = parsedUrl.searchParams || {};
  const utmSource = searchParams.utm_source;
  const utmMedium = searchParams.utm_medium;
  const utmCampaign = searchParams.utm_campaign;
  const gclid = searchParams.gclid;
  const gclsrc = searchParams.gclsrc;
  
  const result = {
    source: '(not set)',
    medium: '(not set)',
    campaign: utmCampaign || '(not set)'
  };
  
  if (utmSource || utmMedium) {
    result.source = utmSource || '(not set)';
    result.medium = utmMedium || '(not set)';
    return result;
  }
  
  if (gclid || (gclsrc && ['aw.ds', 'ds', ''].indexOf(gclsrc) !== -1)) {
    result.source = 'google';
    result.medium = 'cpc';
    if (!utmCampaign) result.campaign = 'google_ads';
    return result;
  }
  
  const referrerUrl = cache.pageReferrer;
  if (referrerUrl) {
    const referrerTLD = computeEffectiveTldPlusOne(referrerUrl);

    // Self-referral: internal navigation must not become source=own-domain /
    // medium=referral (GA4 ignores same-domain referrers). Only when BOTH
    // eTLD+1 lookups succeed, so a failed lookup can't misclassify.
    const pageTLD = cache.pageLocation ? computeEffectiveTldPlusOne(cache.pageLocation) : null;
    if (referrerTLD && pageTLD && referrerTLD === pageTLD) {
      result.source = '(direct)';
      result.medium = '(none)';
      return result;
    }

    const parsedReferrer = parseUrl(referrerUrl);
    const referrerDomain = parsedReferrer ? parsedReferrer.hostname : null;
    
    // Search engines
    const searchEngines = [
      {tld: 'google.', platform: 'google'},
      {tld: 'bing.', platform: 'bing'},
      {tld: 'yahoo.', platform: 'yahoo'},
      {tld: 'duckduckgo.', platform: 'duckduckgo'}
    ];
    
    for (let i = 0; i < searchEngines.length; i++) {
      if (referrerTLD && stringContains(referrerTLD, searchEngines[i].tld)) {
        result.source = searchEngines[i].platform;
        result.medium = 'organic';
        return result;
      }
    }
    
    // Social referrers
    const socialReferrers = [
      {tld: 'facebook.com', platform: 'facebook'},
      {tld: 't.co', platform: 'twitter'},
      {tld: 'linkedin.com', platform: 'linkedin'},
      {tld: 'instagram.com', platform: 'instagram'}
    ];
    
    for (let i = 0; i < socialReferrers.length; i++) {
      if (referrerTLD && stringContains(referrerTLD, socialReferrers[i].tld)) {
        result.source = socialReferrers[i].platform;
        result.medium = 'social';
        return result;
      }
    }
    
    result.source = referrerDomain;
    result.medium = 'referral';
    return result;
  }
  
  result.source = '(direct)';
  result.medium = '(none)';
  return result;
};

// ============================================================================
// COLLECTED TRAFFIC SOURCE
// ============================================================================
const buildCollectedTrafficSource = () => {
  if (cache.eventOrigin === 'app' || cache.eventOrigin === 'am') return null;
  
  const parsedUrl = parsedPageUrl;
  if (!parsedUrl) return null;
  
  const searchParams = parsedUrl.searchParams || {};
  return {
    manual_source: searchParams.utm_source || null,
    manual_medium: searchParams.utm_medium || null,
    manual_campaign_name: searchParams.utm_campaign || null,
    manual_term: searchParams.utm_term || null,
    manual_content: searchParams.utm_content || null,
    manual_campaign_id: searchParams.utm_id || null,
    manual_creative_format: searchParams.utm_source_platform || null,
    manual_marketing_tactic: searchParams.utm_marketing_tactic || null,
    gclid: searchParams.gclid || null,
    dclid: searchParams.dclid || null,
    srsltid: searchParams.srsltid || null
  };
};

// ============================================================================
// APP INFO
// ============================================================================
const buildAppInfo = (platform) => {
  if (platform !== 'iOS' && platform !== 'Android') return null;
  
  const appId = cache.appId || getEventData('app_name') || getEventData('app_package_name');
  const appVersion = getEventData('app_version') || getEventData('x-ga-app_version_major');
  const installStore = getEventData('x-ga-app_store');
  const firebaseAppId = cache.firebaseId;
  
  if (!appId && !appVersion && !installStore && !firebaseAppId) return null;
  
  return {
    id: appId,
    version: appVersion,
    install_store: installStore,
    firebase_app_id: firebaseAppId,
    install_source: null
  };
};

// ============================================================================
// PRIVACY VALUES
// ============================================================================
const getPrivacyValues = () => {
  const gcs = cache.xGaGcs || cache.gcs;
  let adsStorage = 'Unset';
  let analyticsStorage = 'Unset';
  
  if (gcs && getType(gcs) === 'string' && gcs.length >= 3) {
    switch(gcs.charAt(1)) {
      case '1': analyticsStorage = 'Yes'; break;
      case '0': analyticsStorage = 'No'; break;
    }
    switch(gcs.charAt(2)) {
      case '1': adsStorage = 'Yes'; break;
      case '0': adsStorage = 'No'; break;
    }
  }
  
  return { ads_storage: adsStorage, analytics_storage: analyticsStorage };
};

// ============================================================================
// GEO INFO (uses cached values)
// ============================================================================
const getGeoInfo = () => {
  if (data.defaultGeoPropertiesToInclude === 'none') return [];
  
  // Build exclusions map for O(1) lookup
  const excludedGeoProps = {};
  if (data.geoPropertiesToExclude && getType(data.geoPropertiesToExclude) === 'array') {
    data.geoPropertiesToExclude.forEach(e => { if (e.propertyName) excludedGeoProps[e.propertyName] = 1; });
  }
  
  const eventLocation = cache.eventLocation;
  const geoInfo = [];
  
  const addGeo = (key, value) => {
    if (!excludedGeoProps[key] && value && value !== '(not set)') {
      geoInfo.push({ key: key, value: { string_value: value } });
    }
  };
  
  if (eventLocation && getType(eventLocation) === 'object') {
    addGeo('continent', eventLocation.continent);
    addGeo('sub_continent', eventLocation.sub_continent || eventLocation.subcontinent);
    addGeo('country', eventLocation.country);
    addGeo('region', eventLocation.region);
    addGeo('metro', eventLocation.metro);
    addGeo('city', eventLocation.city);
  }
  
  return geoInfo;
};

// ============================================================================
// DEVICE INFO (uses cached values)
// ============================================================================
const getDeviceInfo = () => {
  if (data.defaultDevicePropertiesToInclude === 'none') return [];
  
  // Build exclusions map for O(1) lookup
  const excludedDeviceProps = {};
  if (data.devicePropertiesToExclude && getType(data.devicePropertiesToExclude) === 'array') {
    data.devicePropertiesToExclude.forEach(e => { if (e.propertyName) excludedDeviceProps[e.propertyName] = 1; });
  }
  
  const deviceInfo = [];
  const eventOrigin = cache.eventOrigin;
  
  const addDevice = (key, value) => {
    if (!excludedDeviceProps[key] && value !== undefined && value !== null && value !== '') {
      const dataType = identifyDataType(value);
      const val = { key: key, value: {} };
      val.value[dataType] = changeDataType(value);
      deviceInfo.push(val);
    }
  };
  
  // Device category (reuse the value computed once in main execution)
  addDevice('category', deviceCategory);
  
  if (eventOrigin === 'app' || eventOrigin === 'am') {
    // App-specific device info
    const xGaPlatform = cache.xGaPlatform;
    if (xGaPlatform) {
      addDevice('operating_system', xGaPlatform === 'ios' ? 'iOS' : 'Android');
    }
    if (cache.osVersion) addDevice('operating_system_version', cache.osVersion);
    if (cache.deviceModel) {
      addDevice('mobile_model_name', cache.deviceModel);
      if (stringContains(cache.deviceModel, 'iPhone') || stringContains(cache.deviceModel, 'iPad')) {
        addDevice('mobile_brand_name', 'Apple');
      }
    }
  } else {
    // Web device info
    const clientHints = cache.clientHints;
    if (clientHints && getType(clientHints) === 'object') {
      if (clientHints.platform) addDevice('operating_system', clientHints.platform);
      if (clientHints.platform_version) addDevice('operating_system_version', clientHints.platform_version);
      if (clientHints.model) addDevice('mobile_model_name', clientHints.model);
      if (clientHints.brand) addDevice('mobile_brand_name', clientHints.brand);
      
      // Browser from client hints
      if (clientHints.brands && getType(clientHints.brands) === 'array') {
        for (let i = 0; i < clientHints.brands.length; i++) {
          const brand = clientHints.brands[i];
          if (brand.brand && brand.brand.toLowerCase().indexOf('not a brand') === -1) {
            addDevice('web_info.browser', brand.brand);
            if (brand.version) addDevice('web_info.browser_version', brand.version);
            break;
          }
        }
      }
    }
    
    // Hostname for web
    const hostname = cache.pageHostname || cache.host;
    if (hostname) addDevice('web_info.hostname', hostname);
  }
  
  // Common fields
  if (cache.language) addDevice('language', cache.language);
  if (cache.screenResolution) addDevice('screen_resolution', cache.screenResolution);
  
  return deviceInfo;
};

// ============================================================================
// AUTO EVENT PARAMETERS (OPTIMIZED - uses cached data)
// ============================================================================
const getAutoEventParams = () => {
  if (data.defaultParametersToInclude === 'none') return [];
  if (!cachedAllEventData || getType(cachedAllEventData) !== 'object') return [];
  
  // Build user exclusions map for O(1) lookup
  const userExcludedParams = {};
  if (data.parametersToExclude && getType(data.parametersToExclude) === 'array') {
    data.parametersToExclude.forEach(e => { if (e.parameterName) userExcludedParams[e.parameterName] = 1; });
  }
  
  const autoEventParams = [];
  const allKeys = Object.keys(cachedAllEventData);
  
  for (let i = 0; i < allKeys.length; i++) {
    const key = allKeys[i];
    
    // O(1) system field check instead of O(n) indexOf
    if (SYSTEM_FIELDS[key]) continue;
    if (userExcludedParams[key]) continue;
    if (key.charAt(0) === '_') continue;
    if (key.indexOf('x-ga-') === 0) continue;
    
    const value = cachedAllEventData[key];
    
    if (data.excludeEmptyParams === true && 
        (getType(value) === 'undefined' || getType(value) === 'null' || value === '')) {
      continue;
    }
    
    autoEventParams.push({ key: key, value: value });
  }
  
  return autoEventParams;
};

// ============================================================================
// AUTO USER PROPERTIES (OPTIMIZED)
// ============================================================================
const getAutoUserProperties = () => {
  if (data.defaultUserPropertiesToInclude === 'none') return [];
  
  // Build exclusions map for O(1) lookup
  const userExcludedProps = {};
  if (data.userPropertiesToExclude && getType(data.userPropertiesToExclude) === 'array') {
    data.userPropertiesToExclude.forEach(e => { if (e.propertyName) userExcludedProps[e.propertyName] = 1; });
  }
  
  const autoUserProperties = [];
  const processedKeys = {};
  
  // Process mp2 user properties (Firebase/app events)
  const mp2UserProperties = cache.mp2UserProperties;
  if (mp2UserProperties && getType(mp2UserProperties) === 'object') {
    const propKeys = Object.keys(mp2UserProperties);
    
    for (let i = 0; i < propKeys.length; i++) {
      const propName = propKeys[i];
      
      if (userExcludedProps[propName]) continue;
      if (USER_SYSTEM_FIELDS[propName]) continue;
      
      const propValue = mp2UserProperties[propName];
      
      if (data.excludeEmptyParams === true && 
          (getType(propValue) === 'undefined' || getType(propValue) === 'null' || propValue === '')) {
        continue;
      }
      
      autoUserProperties.push({ key: propName, value: propValue });
      processedKeys[propName] = 1;
    }
  }
  
  return autoUserProperties;
};

// ============================================================================
// EXTRACT EVENT PARAMS
// ============================================================================
const extractEventParams = (eventDataFields, targetArray) => {
  if (getType(eventDataFields) !== 'array' || eventDataFields.length === 0) return;
  
  for (let i = 0; i < eventDataFields.length; i++) {
    const field = eventDataFields[i];
    const fieldDataType = identifyDataType(field.value);
    if (!fieldDataType) continue;  // skip null/undefined values (no null-valued params written)
    const excludedRow = data.excludeEmptyParams === true &&
          (getType(field.value) === 'undefined' || getType(field.value) === 'null');

    if (!excludedRow) {
      const val = { key: field.key, value: {} };
      val.value[fieldDataType] = changeDataType(field.value);
      targetArray.push(val);
    }
  }
};

// ============================================================================
// MAIN EXECUTION
// ============================================================================

// Determine platform early (needed for other functions)
const platform = determinePlatform();
const deviceCategory = determineDeviceCategory();

// Get derived values
const trafficAttributes = determineTrafficAttributes();
const userPseudoId = getUserPseudoId(platform);
const userId = extractUserId();
const sessionInfo = extractSessionInfo();
const privacyValues = getPrivacyValues();
const collectedTrafficSource = buildCollectedTrafficSource();
const appInfo = buildAppInfo(platform);

// Get stream_id
const streamId = cache.streamId;

// Prefer the GA4-provided client event time; fall back to server receive time.
// event_timestamp is stored in microseconds (GA4 BigQuery convention).
const resolveEventTimestampMicros = () => {
  const tsMillis = getEventData('x-ga-timestamp_millis');
  if (tsMillis) {
    const m = makeInteger(tsMillis);
    if (m > 0) return m * 1000;
  }
  return getTimestampMillis() * 1000;
};

const eventTimestampMicros = resolveEventTimestampMicros();

// Build the row object
const row = {
  event_date: formatDateForBigQuery(eventTimestampMicros / 1000),
  event_timestamp: eventTimestampMicros,  // Microseconds
  event_name: data.eventName,
  user_id: userId,
  ga_session_id: sessionInfo.sessionId,
  ga_session_number: sessionInfo.sessionNumber,
  user_pseudo_id: userPseudoId,
  stream_id: streamId ? convertToString(streamId) : null,
  source: trafficAttributes.source,
  medium: trafficAttributes.medium,
  campaign: trafficAttributes.campaign,
  collected_traffic_source: collectedTrafficSource,
  platform: platform,
  device_category: deviceCategory,
  app_info: appInfo,
  event_params: [],
  user_properties: [],
  geo: getGeoInfo(),
  device: getDeviceInfo(),
  privacy_info: [
    { key: 'ads_storage', value: { string_value: privacyValues.ads_storage } },
    { key: 'analytics_storage', value: { string_value: privacyValues.analytics_storage } }
  ]
};

// Process event parameters
const autoEventParams = getAutoEventParams();
extractEventParams(autoEventParams, row.event_params);

// Add manual event params
if (data.eventDataFields) {
  extractEventParams(data.eventDataFields, row.event_params);
}

// Remove duplicate keys, keeping the LAST occurrence so manually added
// entries (appended after auto-detected ones) win. O(1) lookups via object.
const dedupeByKey = (entries) => {
  const seenKeys = {};
  const unique = [];
  for (let i = entries.length - 1; i >= 0; i--) {
    const entry = entries[i];
    if (!seenKeys[entry.key]) {
      seenKeys[entry.key] = 1;
      unique.unshift(entry);
    }
  }
  return unique;
};

row.event_params = dedupeByKey(row.event_params);

// Process user properties
const autoUserProperties = getAutoUserProperties();
extractEventParams(autoUserProperties, row.user_properties);

if (data.userProperties && getType(data.userProperties) === 'array') {
  extractEventParams(data.userProperties, row.user_properties);
}

row.user_properties = dedupeByKey(row.user_properties);

// Add manual geo/device properties (deduped so a manual key overrides the
// auto-detected value instead of appearing twice in the repeated record)
if (data.geoProperties && getType(data.geoProperties) === 'array') {
  extractEventParams(data.geoProperties, row.geo);
  row.geo = dedupeByKey(row.geo);
}
if (data.deviceProperties && getType(data.deviceProperties) === 'array') {
  extractEventParams(data.deviceProperties, row.device);
  row.device = dedupeByKey(row.device);
}

// Connection info
const connectionInfo = {
  projectId: data.bqProject,
  datasetId: data.bqDataset,
  tableId: data.bqTable
};

const options = {
  ignoreUnknownValues: true,
  skipInvalidRows: true
};

// Debug logging (only when enabled)
if (data.consoleLog === true) {
  log('=== BigQuery Data Debug (Optimized + Async) ===');
  log('Platform:', platform);
  log('Event Params Count:', row.event_params.length);
  log('User Properties Count:', row.user_properties.length);
  log('Row Data:', JSON.stringify(row));
  log('=== End Debug ===');
}

// ============================================================================
// ASYNC PATTERN: Signal tag success BEFORE BigQuery insert completes
// ============================================================================
// By calling gtmOnSuccess() BEFORE the BigQuery.insert() call, we tell the
// GTM container that this tag is "done" immediately. The BigQuery insert
// will still execute and complete in the background.
// 
// IMPORTANT TRADE-OFF:
// - PRO: Tag execution time drops from 5s to ~50ms (perceived as instant)
// - CON: If BigQuery insert fails, GTM still thinks the tag succeeded
// - For analytics data, this trade-off is usually acceptable
//
// The runContainer() call in sGTM waits for all tags to call gtmOnSuccess/Failure
// before sending the response. By calling it early, we don't block the response.
// ============================================================================

// Signal success immediately - this unblocks the container response
data.gtmOnSuccess();

// Now do the BigQuery insert in the background. CPU stays allocated on the
// Cloud Run service (--no-cpu-throttling), so this completes after the response.
// Retries once on failure to recover transient BigQuery errors (e.g. 503 / rate limit).
// Known limits: the sandbox has no timer API, so the retry is immediate (no
// backoff), and BigQuery.insert exposes no insertId, so a retry after a
// timeout-shaped "failure" that actually landed can double-insert the row.
// For analytics data a rare duplicate beats a lost event.
const insertToBigQuery = (isRetry) => {
  BigQuery.insert(
    connectionInfo,
    [row],
    options,
    () => {
      // Success callback - tag already marked as success
      if (data.consoleLog === true) {
        log('BigQuery insert succeeded (async)' + (isRetry ? ' on retry' : ''));
      }
    },
    (errors) => {
      // Failure callback - tag already marked as success.
      // Transient (first) failures log only in debug mode: at production
      // volume an outage would otherwise flood stdout, which the Cloud
      // Logging exclusion filter does NOT drop. The final failure logs
      // unconditionally: the "BigQuery insert FAILED" alert matches it.
      if (!isRetry) {
        if (data.consoleLog === true) {
          log('BigQuery insert failed, retrying once (async):', JSON.stringify(errors));
        }
        insertToBigQuery(true);
      } else {
        log('BigQuery insert FAILED after retry (async):', JSON.stringify(errors));
      }
    }
  );
};

insertToBigQuery(false);


